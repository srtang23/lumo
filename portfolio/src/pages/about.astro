---
import Base from "../layouts/Base.astro"
import AboutScatter from "../components/AboutScatter.tsx"
---

<Base title="About · Sophia Tang">
    <main class="about">
        <h1 class="sr-only">About Sophia Tang</h1>
        <div class="stage">
            <AboutScatter
                client:load
                intro="Hi, I’m Sophia. I’m a product designer who brings curiosity to everyday interactions and a strategic lens to complex challenges."
                hint="Click the images to learn more about me."
            />
        </div>
    </main>
</Base>

<style>
    .about {
        position: relative;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
    }
    .stage {
        position: absolute;
        top: 6.25rem;
        left: 0;
        right: 0;
        bottom: 2.5rem;
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }
</style>
