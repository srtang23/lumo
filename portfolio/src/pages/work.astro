---
import Base from "../layouts/Base.astro"
import { projects, workOrder } from "../data/projects"

const list = workOrder.map((slug) => projects.find((p) => p.slug === slug)!)
---

<Base title="Work · Sophia Tang">
    <main class="projects">
        <header class="heading">
            <h1 class="reveal">Work</h1>
            <p class="body reveal" style="--delay: 0.08s">Selected projects</p>
        </header>
        <div class="list">
            {
                list.map((p, i) => (
                    <a class="feature reveal" href={p.href}>
                        <div class="text">
                            <h2>{p.title}</h2>
                            <p class="body">{p.blurb}</p>
                        </div>
                        <div class="image">
                            <img src={p.image} alt={p.alt} loading={i < 1 ? "eager" : "lazy"} />
                        </div>
                    </a>
                ))
            }
        </div>
    </main>
</Base>

<style>
    .projects {
        display: flex;
        flex-direction: column;
        gap: 4rem;
        width: 100%;
        max-width: 60rem;
        margin: 0 auto;
        padding: 10rem 1.5rem 11.25rem;
    }
    .heading {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-align: center;
    }
    h1 {
        font: italic 800 4rem/1.1 "Urbanist", var(--sans);
        letter-spacing: -0.5px;
        color: var(--ink);
    }
    .list {
        display: grid;
        gap: 3rem;
    }
    .feature {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.75rem;
        height: 37.5rem;
        padding: 2.5rem 2.5rem 0;
        background: var(--white);
        border-radius: 1.5rem;
        overflow: hidden;
    }
    .text {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        text-align: center;
    }
    h2 {
        font: 500 1.75rem/1.3 var(--serif);
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .image {
        flex: 1;
        width: 100%;
        min-height: 0;
        border-radius: 1rem 1rem 0 0;
        overflow: hidden;
    }
    .image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s var(--spring);
    }
    .feature:hover .image img {
        transform: scale(1.015);
    }

    @media (max-width: 1199.98px) {
        .projects {
            padding: 8.75rem 2.5rem 10rem;
        }
        .feature {
            height: 32.5rem;
        }
    }
    @media (max-width: 809.98px) {
        .projects {
            gap: 2.5rem;
            padding: 7.5rem 1.25rem 8.75rem;
        }
        h1 {
            font-size: 2.75rem;
        }
        .list {
            gap: 2rem;
        }
        .feature {
            height: 27.5rem;
        }
    }
</style>
