---
import { links } from "../data/projects"
---

<nav class="top-nav" aria-label="Main">
    <div class="fade" aria-hidden="true"></div>
    <div class="center">
        <a class="link" href="/work">Work</a>
        <a class="logo" href="/" aria-label="Home"><img src="/images/logo.png" alt="" width="30" height="24" /></a>
        <a class="link" href="/about">About</a>
    </div>
    <div class="external">
        <a class="link text" href={links.resume} target="_blank" rel="noopener noreferrer">Resume ↗</a>
        <a class="link text" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class="icon" href={links.resume} target="_blank" rel="noopener noreferrer" aria-label="Resume (opens in a new tab)">
            <img src="/images/icon-resume.svg" alt="" width="16" height="16" />
        </a>
        <a class="icon" href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
            <img src="/images/icon-linkedin.svg" alt="" width="16" height="16" />
        </a>
    </div>
</nav>

<style>
    .top-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1.5rem;
    }
    .fade {
        position: absolute;
        inset: 0 0 -3rem 0;
        background: linear-gradient(rgba(251, 250, 247, 0.96) 0%, rgba(251, 250, 247, 0.85) 45%, rgba(251, 250, 247, 0) 100%);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        mask-image: linear-gradient(#000 40%, transparent 100%);
        -webkit-mask-image: linear-gradient(#000 40%, transparent 100%);
        pointer-events: none;
    }
    .center {
        position: relative;
        display: flex;
        align-items: center;
        gap: 3.5rem;
    }
    .link {
        font: 400 0.75rem/1.4 var(--sans);
        letter-spacing: 0.01em;
        color: var(--nav);
        transition: color 0.2s ease;
    }
    .link:hover {
        color: var(--ink);
    }
    .logo img {
        width: 1.875rem;
        height: 1.5rem;
        transition: transform 0.7s var(--spring);
    }
    .logo:hover img {
        transform: rotate(360deg);
    }
    .external {
        position: absolute;
        top: 1.6875rem;
        right: 2.5rem;
        display: flex;
        align-items: center;
        gap: 1.75rem;
    }
    .icon {
        display: none;
    }
    .icon img {
        width: 1rem;
        height: 1rem;
        opacity: 0.85;
        transition: opacity 0.2s ease;
    }
    .icon:hover img {
        opacity: 1;
    }
    @media (max-width: 1199.98px) {
        .external {
            top: 1.75rem;
            right: 1.5rem;
        }
    }
    @media (max-width: 809.98px) {
        .external {
            right: 1rem;
            gap: 0.875rem;
        }
        .text {
            display: none;
        }
        .icon {
            display: block;
        }
    }
</style>
